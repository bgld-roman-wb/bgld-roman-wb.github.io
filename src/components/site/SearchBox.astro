---
// Custom dictionary search — replaces the earlier Pagefind-based full-text search. Pagefind
// indexes whole rendered pages and can't restrict a match to one field, so it couldn't express
// "search direction" (Roman word vs. gloss) as a real structural filter. This instead fetches a
// slim per-entry search index (public/search-index.json, built by
// scripts/pipeline/build-search-index.mjs) and matches client-side via src/lib/search.ts.
//
// Direction (Roman → gloss vs. gloss → Roman) is the one thing that has to be an explicit,
// visible choice — it changes which field is searched, so a silent wrong guess would just look
// like "no results". It's a single label + swap button, not a toggle pair, to keep the row
// visually light. Match mode (exact vs. fuzzy) isn't user-facing at all: runSearch() always tries
// exact first and only falls back to fuzzy if that comes up empty, so typos are forgiven without
// asking the user to think about "exact vs. fuzzy" up front.
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Persisted across view transitions: the search box holds the parsed 1.8MB index in the
     module scope of its script, and re-fetching/re-parsing that on every word you open is what
     made stepping through the dictionary feel heavy. Keeping the node keeps the index, the
     listeners, and whatever the reader had typed. The name has to be a literal (the compiler does
     not evaluate an expression here), so the same box is reused across the two app languages and
     the script re-localizes it on navigation — see syncLocale() below. -->
<div class="search" data-search data-lang={lang} transition:persist="search">
	<div class="search-row">
		<div class="search-input-wrap">
			<input
				type="text"
				data-search-input
				placeholder={t('search.placeholderToGloss')}
				autocomplete="off"
				spellcheck="false"
				role="combobox"
				aria-expanded="false"
				aria-controls="search-results"
				aria-autocomplete="list"
			/>
			<ul id="search-results" data-search-results class="search-results" role="listbox" hidden></ul>
		</div>
		<div class="direction-control">
			<span class="direction-label" data-direction-label>{t('search.direction.toGloss')}</span>
			<button type="button" class="swap-btn" data-direction-swap aria-label={t('search.direction.swap')} title={t('search.direction.swap')}>
				<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M7 4 3.5 7.5 7 11" />
					<path d="M3.5 7.5h17" />
					<path d="m17 13 3.5 3.5-3.5 3.5" />
					<path d="M20.5 16.5h-17" />
				</svg>
			</button>
		</div>
	</div>
</div>

<script>
	import { matchRanges, search, type Direction, type SearchRecord } from '../../lib/search';
	import { localizePath, useTranslations, type Locale } from '../../i18n/ui';
	import { prefetch } from 'astro:prefetch';
	import { navigate } from 'astro:transitions/client';

	const STORAGE_KEY = 'search:direction';
	// Single source of truth for these strings is ui.ts (via useTranslations), same as every
	// server-rendered label — no separate copy hardcoded here to drift out of sync.
	const DIRECTION_LABEL: Record<Direction, 'search.direction.toGloss' | 'search.direction.toRoman'> = {
		'roman-to-gloss': 'search.direction.toGloss',
		'gloss-to-roman': 'search.direction.toRoman',
	};
	const PLACEHOLDER: Record<Direction, 'search.placeholderToGloss' | 'search.placeholderToRoman'> = {
		'roman-to-gloss': 'search.placeholderToGloss',
		'gloss-to-roman': 'search.placeholderToRoman',
	};
	const OTHER_DIRECTION: Record<Direction, Direction> = {
		'roman-to-gloss': 'gloss-to-roman',
		'gloss-to-roman': 'roman-to-gloss',
	};

	let index: SearchRecord[] | null = null;
	let indexPromise: Promise<SearchRecord[]> | null = null;

	function loadIndex(): Promise<SearchRecord[]> {
		if (!indexPromise) {
			indexPromise = fetch('/search-index.json')
				.then((r) => r.json())
				.then((data: SearchRecord[]) => (index = data));
		}
		return indexPromise;
	}
	// Fetch as soon as the script runs, rather than waiting for a focus/input event to trigger
	// it — a 'focus' listener alone is fragile (e.g. programmatic or assistive-tech focus doesn't
	// always dispatch a real focus event), and at ~400KB gzipped this is cheap to front-load on a
	// site whose whole purpose is this search.
	//
	// This module is evaluated once per document, and view transitions keep the document alive
	// across navigations, so `index` is parsed exactly once per visit rather than once per word
	// opened (the parse alone was ~50ms on desktop, several times that on a phone).
	loadIndex();

	function readDirection(): Direction {
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			if (raw === 'roman-to-gloss' || raw === 'gloss-to-roman') return raw;
		} catch {
			// Storage disabled — fall through to the default.
		}
		return 'roman-to-gloss';
	}

	function writeDirection(direction: Direction) {
		try {
			localStorage.setItem(STORAGE_KEY, direction);
		} catch {
			// Storage disabled — preference just won't persist across visits.
		}
	}

	// The header search is transition:persist'ed, so on most navigations the same node comes
	// through with its listeners intact; but a locale switch (or any page that renders a fresh
	// box) brings a new node that still needs wiring. Bind on every page load, skipping nodes
	// already handled — cheap, and it never double-binds.
	const wired = new WeakSet<HTMLElement>();

	function wireSearchBoxes() {
		for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) {
			if (wired.has(root)) continue;
			wired.add(root);
			wireSearchBox(root);
		}
	}

	function wireSearchBox(root: HTMLElement) {
		// Not captured once: this box outlives the page it was rendered on, so after a switch to
		// the other app language it is still the same node with the old locale baked in. Track the
		// live document language instead and re-localize on navigation (syncLocale, below).
		let lang = (root.dataset.lang as Locale) ?? 'de';
		let t = useTranslations(lang);
		const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
		const resultsEl = root.querySelector<HTMLUListElement>('[data-search-results]')!;
		const directionLabel = root.querySelector<HTMLElement>('[data-direction-label]')!;
		const swapBtn = root.querySelector<HTMLButtonElement>('[data-direction-swap]')!;

		let direction = readDirection();
		let activeIndex = -1;
		// What to paint in the rendered rows, captured at search time: the query only marks up the
		// field the search actually ran against, and it is cleared for fuzzy hits, where by
		// definition no literal substring exists to point at.
		let highlightQuery = '';
		let highlightDirection: Direction = direction;
		let currentResults: { slug: string; headword: string; subheadword?: string; gloss?: string; matchedForm?: string }[] = [];

		function applyDirectionToUI() {
			directionLabel.textContent = t(DIRECTION_LABEL[direction]);
			input.placeholder = t(PLACEHOLDER[direction]);
		}
		applyDirectionToUI();

		function closeResults() {
			resultsEl.hidden = true;
			resultsEl.innerHTML = '';
			input.setAttribute('aria-expanded', 'false');
			input.removeAttribute('aria-activedescendant');
			activeIndex = -1;
		}

		// Writes `text` into `parent`, wrapping the parts the query matched in <mark>. Assembled as
		// nodes rather than an HTML string: this is the one place a reader's own typing reaches the
		// DOM, and matchRanges() maps the folded match back onto the displayed spelling, so a search
		// for "atscha" marks the accented "átscha" correctly.
		function appendHighlighted(parent: HTMLElement, text: string, query: string) {
			let at = 0;
			for (const [start, end] of query ? matchRanges(text, query) : []) {
				if (start > at) parent.appendChild(document.createTextNode(text.slice(at, start)));
				const mark = document.createElement('mark');
				mark.textContent = text.slice(start, end);
				parent.appendChild(mark);
				at = end;
			}
			parent.appendChild(document.createTextNode(text.slice(at)));
		}

		function renderResults() {
			resultsEl.innerHTML = '';
			if (currentResults.length === 0) {
				const li = document.createElement('li');
				li.className = 'search-empty';
				li.textContent = t('search.noResults');
				resultsEl.appendChild(li);
				resultsEl.hidden = false;
				input.setAttribute('aria-expanded', 'true');
				return;
			}
			// Roman fields and glosses are searched separately (that's what direction *means*), so
			// only the side that was searched gets marked — highlighting a stray "ess" in a gloss
			// during a Roman search would point at something that had no part in the match.
			const romanQuery = highlightDirection === 'roman-to-gloss' ? highlightQuery : '';
			const glossQuery = highlightDirection === 'gloss-to-roman' ? highlightQuery : '';
			currentResults.forEach((r, i) => {
				const li = document.createElement('li');
				li.id = `search-option-${i}`;
				li.setAttribute('role', 'option');
				li.className = 'search-result' + (i === activeIndex ? ' active' : '');
				const a = document.createElement('a');
				a.href = localizePath(`/entry/${r.slug}`, lang);
				const headword = document.createElement('strong');
				appendHighlighted(headword, r.headword, romanQuery);
				a.appendChild(headword);
				if (r.subheadword) {
					const sub = document.createElement('span');
					sub.className = 'sub';
					sub.appendChild(document.createTextNode(' '));
					appendHighlighted(sub, r.subheadword, romanQuery);
					a.appendChild(sub);
				}
				if (r.matchedForm) {
					// The query hit a variant spelling, not the headword itself — show it, or the
					// match would look unexplained (e.g. "hí" for a search on "si").
					const form = document.createElement('span');
					form.className = 'matched-form';
					form.appendChild(document.createTextNode(' ('));
					appendHighlighted(form, r.matchedForm, romanQuery);
					form.appendChild(document.createTextNode(')'));
					a.appendChild(form);
				}
				if (r.gloss) {
					const gloss = document.createElement('span');
					gloss.className = 'gloss';
					gloss.appendChild(document.createTextNode(' — '));
					appendHighlighted(gloss, r.gloss, glossQuery);
					a.appendChild(gloss);
				}
				li.appendChild(a);
				resultsEl.appendChild(li);
			});
			resultsEl.hidden = false;
			input.setAttribute('aria-expanded', 'true');
			// The top hit is the one most people take; warm it as soon as the list appears so the
			// click has nothing left to wait for. The rest are warmed on hover/arrow (below).
			if (currentResults[0]) prefetch(localizePath(`/entry/${currentResults[0].slug}`, lang));
		}

		// Arrowing onto a row is the keyboard equivalent of hovering it.
		function warmActive() {
			const r = currentResults[activeIndex];
			if (r) prefetch(localizePath(`/entry/${r.slug}`, lang));
		}

		function runSearch() {
			const query = input.value;
			if (!query.trim() || !index) {
				closeResults();
				return;
			}
			const glossLang = lang === 'en' ? 'en' : 'de';
			// Exact first, so a clean match isn't crowded out by looser fuzzy noise; fuzzy only
			// steps in when exact finds nothing, so a typo still isn't a dead end.
			let results = search(index, query, { direction, mode: 'exact', glossLang, limit: 20 });
			highlightQuery = query.trim();
			if (results.length === 0) {
				results = search(index, query, { direction, mode: 'fuzzy', glossLang, limit: 20 });
				highlightQuery = '';
			}
			highlightDirection = direction;
			currentResults = results;
			activeIndex = -1;
			renderResults();
		}

		let debounceHandle: ReturnType<typeof setTimeout> | undefined;
		input.addEventListener('input', () => {
			clearTimeout(debounceHandle);
			debounceHandle = setTimeout(runSearch, 100);
		});
		// Re-open the results panel if the field already has a query (e.g. tabbing back in).
		input.addEventListener('focus', () => {
			if (input.value.trim()) loadIndex().then(runSearch);
		});

		swapBtn.addEventListener('click', () => {
			direction = OTHER_DIRECTION[direction];
			writeDirection(direction);
			applyDirectionToUI();
			runSearch();
			input.focus();
		});

		input.addEventListener('keydown', (e) => {
			if (resultsEl.hidden) return;
			if (e.key === 'ArrowDown') {
				e.preventDefault();
				activeIndex = Math.min(activeIndex + 1, currentResults.length - 1);
				renderResults();
				input.setAttribute('aria-activedescendant', `search-option-${activeIndex}`);
				warmActive();
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				activeIndex = Math.max(activeIndex - 1, 0);
				renderResults();
				input.setAttribute('aria-activedescendant', `search-option-${activeIndex}`);
				warmActive();
			} else if (e.key === 'Enter') {
				const target = activeIndex >= 0 ? currentResults[activeIndex] : currentResults[0];
				if (target) {
					e.preventDefault();
					// navigate(), not location.href — the latter would force a full document load and
					// throw away the parsed index this box is holding.
					navigate(localizePath(`/entry/${target.slug}`, lang));
				}
			} else if (e.key === 'Escape') {
				closeResults();
				input.blur();
			}
		});

		// Result rows are built at runtime, so Astro's own per-anchor hover prefetch (which binds
		// on page load) never sees them. Delegate instead: pointing at a row is the strongest
		// signal there is that it's about to be clicked.
		resultsEl.addEventListener(
			'pointerover',
			(e) => {
				const a = (e.target as Element | null)?.closest?.('a');
				if (a instanceof HTMLAnchorElement) prefetch(a.href);
			},
			{ passive: true }
		);

		document.addEventListener('click', (e) => {
			if (!root.contains(e.target as Node)) closeResults();
		});

		// The box survives navigation, so its open dropdown would otherwise stay parked on top of
		// the entry the reader just opened. Drop the panel but keep the query — going back to the
		// list is one focus away, and no re-search or re-parse is involved.
		document.addEventListener('astro:after-swap', () => {
			if (!resultsEl.hidden) closeResults();
		});

		// Switching app language navigates to the /en/ (or /) twin of the current page; the box
		// itself is persisted, so nothing about it would change without this. Re-point it at the
		// new locale: labels, placeholder, which gloss language is searched, and where results link.
		document.addEventListener('astro:page-load', () => {
			const docLang: Locale = document.documentElement.lang === 'en' ? 'en' : 'de';
			if (docLang === lang) return;
			lang = docLang;
			t = useTranslations(lang);
			root.dataset.lang = lang;
			applyDirectionToUI();
			if (input.value.trim()) runSearch();
		});
	}

	wireSearchBoxes();
	document.addEventListener('astro:page-load', wireSearchBoxes);
</script>

<style>
	.search {
		/* No cap of its own — fills the header's .container, same as everything else on the
		   page (60rem, see --max-width in global.css), so it lines up with the content below
		   it instead of looking like a narrower, separate element. */
		width: 100%;
	}
	.search-row {
		display: flex;
		align-items: stretch;
		gap: var(--space-2);
	}
	.direction-control {
		display: flex;
		align-items: center;
		gap: var(--space-1);
		flex-shrink: 0;
		white-space: nowrap;
		padding-inline: 0.7em;
		border: 1px solid var(--color-border);
		border-radius: 0.4rem;
	}
	.direction-label {
		font-size: 0.8rem;
		color: var(--color-muted);
	}
	.swap-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		padding: 0.15em;
		cursor: pointer;
		color: var(--color-muted);
		border-radius: 0.3rem;
	}
	.swap-btn:hover {
		color: var(--color-accent);
	}
	.swap-btn .icon {
		inline-size: 0.95rem;
		block-size: 0.95rem;
	}
	.search-input-wrap {
		position: relative;
		flex: 1;
		min-width: 0;
	}
	[data-search-input] {
		width: 100%;
		font: inherit;
		font-size: 1rem;
		padding: 0.5em 0.8em;
		border: 1px solid var(--color-border);
		border-radius: 0.4rem;
		background: var(--color-bg);
		color: var(--color-text);
	}
	[data-search-input]:focus-visible {
		/* A soft ring rather than the site's 3px accent slab: this field is focused for most of a
		   visit, so a heavy outline would sit on screen the whole time. Plain accent first as the
		   fallback for engines without color-mix() — they keep a fully opaque ring. */
		outline: 2px solid var(--color-accent);
		outline: 2px solid color-mix(in oklab, var(--color-accent) 45%, transparent);
		outline-offset: 0;
		border-color: var(--color-accent);
	}
	.search-results {
		position: absolute;
		z-index: 20;
		inset-inline: 0;
		top: calc(100% + 0.35em);
		margin: 0;
		padding: 0.3em;
		list-style: none;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 0.7rem;
		/* Two layers: a hairline contact shadow so the panel doesn't look pasted on, and a wide
		   soft one for depth. */
		box-shadow:
			0 1px 2px rgb(0 0 0 / 0.05),
			0 10px 30px rgb(0 0 0 / 0.1);
		max-height: 22rem;
		overflow-y: auto;
		overscroll-behavior: contain;
		animation: search-results-in 0.12s ease-out;
	}
	/* A black shadow is invisible against a dark panel, so depth there comes from a light
	   hairline plus a deeper ambient shadow. */
	:global(:root[data-theme='dark']) .search-results {
		box-shadow:
			0 0 0 1px rgb(255 255 255 / 0.04),
			0 12px 34px rgb(0 0 0 / 0.5);
	}
	@keyframes search-results-in {
		from {
			opacity: 0;
			transform: translateY(-2px);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.search-results {
			animation: none;
		}
	}

	/* Rows are built by renderResults() at runtime, so they never carry Astro's scoping
	   attribute — without :global() none of the rules below match, and every row falls back to
	   the site-wide `a { color: accent }`, which is what made the whole list violet. Each
	   selector is anchored on .search-results (which is in the template, so it is scoped), so
	   nothing leaks outside the panel. */
	.search-results :global(.search-result a) {
		display: block;
		padding: 0.4em 0.6em;
		border-radius: 0.45rem;
		text-decoration: none;
		color: var(--color-text);
		/* One line per result keeps a 20-row list scannable. The headword is what the eye tracks
		   down the list, so the gloss is the half that gets clipped. */
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.search-results :global(.search-result strong) {
		font-weight: 600;
	}
	.search-results :global(.search-result.active a),
	.search-results :global(.search-result a:hover) {
		background: var(--color-surface);
		background: color-mix(in oklab, var(--color-accent) 8%, var(--color-bg));
	}
	/* The accent marks the one row the user is actually on, instead of coloring all twenty. */
	.search-results :global(.search-result.active strong) {
		color: var(--color-accent);
	}
	/* The matched letters, per direction: a whisper of the accent behind them, no color or weight
	   change, so twenty rows still read as one block of text and the eye picks out the match
	   rather than being pulled to it. Plain --color-surface first for engines without
	   color-mix(); `mark`'s UA default is a hard yellow slab, so the background is always set. */
	.search-results :global(.search-result mark) {
		background: var(--color-surface);
		background: color-mix(in oklab, var(--color-accent) 14%, transparent);
		color: inherit;
		border-radius: 0.2em;
		padding: 0 0.08em;
	}
	/* The active/hovered row already sits on an 8% accent wash, which all but swallows a 14%
	   mark — lift it just enough to stay legible against that. */
	.search-results :global(.search-result.active mark),
	.search-results :global(.search-result a:hover mark) {
		background: color-mix(in oklab, var(--color-accent) 22%, transparent);
	}
	.search-results :global(.search-result .sub),
	.search-results :global(.search-result .matched-form),
	.search-results :global(.search-result .gloss) {
		color: var(--color-muted);
		font-weight: 400;
	}
	.search-results :global(.search-result .gloss) {
		font-size: 0.92em;
	}
	.search-results :global(.search-empty) {
		padding: 0.5em 0.6em;
		color: var(--color-muted);
		font-size: 0.9rem;
	}

	/* On phones the input shares its row with the direction control, so a panel anchored to the
	   input alone is barely half the screen wide and clips most glosses. Anchor it to the whole
	   row instead — same offset, since .search is exactly as tall as the row. */
	@media (max-width: 36rem) {
		.search {
			position: relative;
		}
		.search-input-wrap {
			position: static;
		}
	}
</style>
