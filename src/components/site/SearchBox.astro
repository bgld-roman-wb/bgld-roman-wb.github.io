---
// Custom dictionary search — replaces the earlier Pagefind-based full-text search. Pagefind
// indexes whole rendered pages and can't restrict a match to one field, so it couldn't express
// "search direction" (Roman word vs. gloss) as a real structural filter. This instead fetches a
// slim per-entry search index (public/search-index.json, built by
// scripts/pipeline/build-search-index.mjs) and matches client-side via src/lib/search.ts. See
// that file's header comment for the Romlex-inspired design (direction + exact/fuzzy, diacritics
// and case always folded away).
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/ui';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<div class="search" data-search data-lang={lang}>
	<div class="search-controls">
		<div class="toggle-group" data-toggle="direction" role="radiogroup" aria-label={t('search.direction.toGloss')}>
			<button type="button" data-value="roman-to-gloss" aria-pressed="true">{t('search.direction.toGloss')}</button>
			<button type="button" data-value="gloss-to-roman" aria-pressed="false">{t('search.direction.toRoman')}</button>
		</div>
		<div class="toggle-group" data-toggle="mode" role="radiogroup" aria-label="match mode">
			<button type="button" data-value="exact" aria-pressed="true">{t('search.mode.exact')}</button>
			<button type="button" data-value="fuzzy" aria-pressed="false">{t('search.mode.fuzzy')}</button>
		</div>
	</div>
	<div class="search-input-wrap">
		<input
			type="text"
			data-search-input
			placeholder={t('search.placeholderToGloss')}
			autocomplete="off"
			spellcheck="false"
			role="combobox"
			aria-expanded="false"
			aria-controls="search-results"
			aria-autocomplete="list"
		/>
		<ul id="search-results" data-search-results class="search-results" role="listbox" hidden></ul>
	</div>
</div>

<script>
	import { search, type Direction, type MatchMode, type SearchRecord } from '../../lib/search';
	import { localizePath, useTranslations, type Locale } from '../../i18n/ui';

	const STORAGE_KEY = 'search:prefs';
	// Single source of truth for these strings is ui.ts (via useTranslations), same as every
	// server-rendered label — no separate copy hardcoded here to drift out of sync.
	const PLACEHOLDER: Record<Direction, 'search.placeholderToGloss' | 'search.placeholderToRoman'> = {
		'roman-to-gloss': 'search.placeholderToGloss',
		'gloss-to-roman': 'search.placeholderToRoman',
	};

	let index: SearchRecord[] | null = null;
	let indexPromise: Promise<SearchRecord[]> | null = null;

	function loadIndex(): Promise<SearchRecord[]> {
		if (!indexPromise) {
			indexPromise = fetch('/search-index.json')
				.then((r) => r.json())
				.then((data: SearchRecord[]) => (index = data));
		}
		return indexPromise;
	}
	// Fetch as soon as the script runs, rather than waiting for a focus/input event to trigger
	// it — a 'focus' listener alone is fragile (e.g. programmatic or assistive-tech focus doesn't
	// always dispatch a real focus event), and at ~400KB gzipped this is cheap to front-load on a
	// site whose whole purpose is this search.
	loadIndex();

	function readPrefs(): { direction: Direction; mode: MatchMode } {
		try {
			const raw = localStorage.getItem(STORAGE_KEY);
			if (raw) {
				const parsed = JSON.parse(raw);
				if (parsed.direction && parsed.mode) return parsed;
			}
		} catch {
			// Storage disabled — fall through to defaults.
		}
		return { direction: 'roman-to-gloss', mode: 'exact' };
	}

	function writePrefs(prefs: { direction: Direction; mode: MatchMode }) {
		try {
			localStorage.setItem(STORAGE_KEY, JSON.stringify(prefs));
		} catch {
			// Storage disabled — preference just won't persist across visits.
		}
	}

	for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) {
		const lang = (root.dataset.lang as Locale) ?? 'de';
		const t = useTranslations(lang);
		const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
		const resultsEl = root.querySelector<HTMLUListElement>('[data-search-results]')!;
		const directionGroup = root.querySelector<HTMLElement>('[data-toggle="direction"]')!;
		const modeGroup = root.querySelector<HTMLElement>('[data-toggle="mode"]')!;

		const prefs = readPrefs();
		let activeIndex = -1;
		let currentResults: { slug: string; headword: string; subheadword?: string; gloss?: string }[] = [];

		function setToggle(group: HTMLElement, value: string) {
			for (const btn of group.querySelectorAll<HTMLButtonElement>('button')) {
				btn.setAttribute('aria-pressed', String(btn.dataset.value === value));
			}
		}

		function applyPrefsToUI() {
			setToggle(directionGroup, prefs.direction);
			setToggle(modeGroup, prefs.mode);
			input.placeholder = t(PLACEHOLDER[prefs.direction]);
		}
		applyPrefsToUI();

		function closeResults() {
			resultsEl.hidden = true;
			resultsEl.innerHTML = '';
			input.setAttribute('aria-expanded', 'false');
			input.removeAttribute('aria-activedescendant');
			activeIndex = -1;
		}

		function renderResults() {
			resultsEl.innerHTML = '';
			if (currentResults.length === 0) {
				const li = document.createElement('li');
				li.className = 'search-empty';
				li.textContent = t('search.noResults');
				resultsEl.appendChild(li);
				resultsEl.hidden = false;
				input.setAttribute('aria-expanded', 'true');
				return;
			}
			currentResults.forEach((r, i) => {
				const li = document.createElement('li');
				li.id = `search-option-${i}`;
				li.setAttribute('role', 'option');
				li.className = 'search-result' + (i === activeIndex ? ' active' : '');
				const a = document.createElement('a');
				a.href = localizePath(`/entry/${r.slug}`, lang);
				const headword = document.createElement('strong');
				headword.textContent = r.headword;
				a.appendChild(headword);
				if (r.subheadword) {
					const sub = document.createElement('span');
					sub.className = 'sub';
					sub.textContent = ` ${r.subheadword}`;
					a.appendChild(sub);
				}
				if (r.gloss) {
					const gloss = document.createElement('span');
					gloss.className = 'gloss';
					gloss.textContent = ` — ${r.gloss}`;
					a.appendChild(gloss);
				}
				li.appendChild(a);
				resultsEl.appendChild(li);
			});
			resultsEl.hidden = false;
			input.setAttribute('aria-expanded', 'true');
		}

		function runSearch() {
			const query = input.value;
			if (!query.trim() || !index) {
				closeResults();
				return;
			}
			currentResults = search(index, query, { direction: prefs.direction, mode: prefs.mode, glossLang: lang === 'en' ? 'en' : 'de', limit: 20 });
			activeIndex = -1;
			renderResults();
		}

		let debounceHandle: ReturnType<typeof setTimeout> | undefined;
		input.addEventListener('input', () => {
			clearTimeout(debounceHandle);
			debounceHandle = setTimeout(runSearch, 100);
		});
		// Re-open the results panel if the field already has a query (e.g. tabbing back in).
		input.addEventListener('focus', () => {
			if (input.value.trim()) loadIndex().then(runSearch);
		});

		for (const group of [directionGroup, modeGroup]) {
			group.addEventListener('click', (e) => {
				const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-value]');
				if (!btn) return;
				const kind = group.dataset.toggle === 'direction' ? 'direction' : 'mode';
				(prefs as any)[kind] = btn.dataset.value;
				writePrefs(prefs);
				applyPrefsToUI();
				runSearch();
				input.focus();
			});
		}

		input.addEventListener('keydown', (e) => {
			if (resultsEl.hidden) return;
			if (e.key === 'ArrowDown') {
				e.preventDefault();
				activeIndex = Math.min(activeIndex + 1, currentResults.length - 1);
				renderResults();
				input.setAttribute('aria-activedescendant', `search-option-${activeIndex}`);
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				activeIndex = Math.max(activeIndex - 1, 0);
				renderResults();
				input.setAttribute('aria-activedescendant', `search-option-${activeIndex}`);
			} else if (e.key === 'Enter') {
				const target = activeIndex >= 0 ? currentResults[activeIndex] : currentResults[0];
				if (target) {
					e.preventDefault();
					window.location.href = localizePath(`/entry/${target.slug}`, lang);
				}
			} else if (e.key === 'Escape') {
				closeResults();
				input.blur();
			}
		});

		document.addEventListener('click', (e) => {
			if (!root.contains(e.target as Node)) closeResults();
		});
	}
</script>

<style>
	.search {
		max-width: 32rem;
	}
	.search-controls {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
		margin-block-end: var(--space-2);
	}
	.toggle-group {
		display: inline-flex;
		border: 1px solid var(--color-border);
		border-radius: 0.4rem;
		overflow: hidden;
	}
	.toggle-group button {
		font: inherit;
		font-size: 0.8rem;
		border: none;
		background: none;
		color: var(--color-muted);
		padding: 0.3em 0.7em;
		cursor: pointer;
	}
	.toggle-group button + button {
		border-inline-start: 1px solid var(--color-border);
	}
	.toggle-group button[aria-pressed='true'] {
		background: var(--color-accent);
		color: var(--color-accent-contrast);
	}
	.search-input-wrap {
		position: relative;
	}
	[data-search-input] {
		width: 100%;
		font: inherit;
		font-size: 1rem;
		padding: 0.5em 0.8em;
		border: 1px solid var(--color-border);
		border-radius: 0.4rem;
		background: var(--color-bg);
		color: var(--color-text);
	}
	[data-search-input]:focus-visible {
		outline: 3px solid var(--color-accent);
		outline-offset: 1px;
	}
	.search-results {
		position: absolute;
		z-index: 20;
		inset-inline: 0;
		top: calc(100% + 0.3em);
		margin: 0;
		padding: 0.3em;
		list-style: none;
		background: var(--color-bg);
		border: 1px solid var(--color-border);
		border-radius: 0.5rem;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
		max-height: 22rem;
		overflow-y: auto;
	}
	.search-result a {
		display: block;
		padding: 0.4em 0.6em;
		border-radius: 0.35rem;
		text-decoration: none;
		color: var(--color-text);
	}
	.search-result.active a,
	.search-result a:hover {
		background: var(--color-surface);
	}
	.search-result .sub,
	.search-result .gloss {
		color: var(--color-muted);
		font-weight: normal;
	}
	.search-empty {
		padding: 0.5em 0.6em;
		color: var(--color-muted);
		font-size: 0.9rem;
	}
</style>
