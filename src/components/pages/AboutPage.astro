---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations, type Locale } from '../../i18n/ui';
import { about, aboutStaff } from '../../data/about';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const content = about[lang];
const manuscriptHref = `/manuscript-${lang}.pdf`;
---

<BaseLayout title={t('about.title')} lang={lang}>
	<article class="about">
		<header class="about-header">
			<h1>{t('about.title')}</h1>
		</header>

		{content.paragraphs.map((html) => <p set:html={html} />)}

		<section class="staff">
			<h2>{content.staffHeadingPlain}<em>{content.staffHeadingLegend}</em></h2>
			<p class="staff-list">
				{aboutStaff.map((person, i) => (
					<>
						{person.mentor ? <em>{person.name}</em> : person.name}
						{i < aboutStaff.length - 1 ? ' — ' : ''}
					</>
				))}
			</p>
		</section>

		<a class="download" href={manuscriptHref} download>{t('about.download')}</a>
	</article>
</BaseLayout>

<style>
	.about {
		max-width: 42rem;
		margin-inline: auto;
	}
	.about-header {
		margin-block-end: var(--space-4);
	}
	.about-header h1 {
		margin: 0;
	}
	.about p {
		line-height: 1.7;
		margin-block: 0 var(--space-3);
	}
	.about :global(.lang-code) {
		font-variant: small-caps;
	}
	.staff {
		margin-block: var(--space-5);
	}
	.staff h2 {
		font-size: 1.1em;
		margin-block-end: var(--space-2);
	}
	.staff-list {
		line-height: 1.8;
	}
	.download {
		display: inline-block;
		margin-block-end: var(--space-4);
		text-decoration: none;
		color: var(--color-accent);
		border: 1px solid var(--color-border);
		border-radius: 0.4rem;
		padding: var(--space-1) var(--space-3);
	}
	.download:hover {
		border-color: var(--color-accent);
	}
</style>
