---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Wordmark from '../site/Wordmark.astro';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Note: unlike the sibling romani-project.github.io Impressum, this project is not represented
// by Akademie Graz on behalf of Roma Service & Romano Centro — that institutional structure is
// specific to the sibling project and hasn't been confirmed for this one, so it's intentionally
// omitted here.
---

<BaseLayout title={t('impressum.title')} lang={lang}>
	<p class="impressum-mark"><Wordmark /></p>
	<h1>{t('impressum.title')}</h1>
	<address>
		Verein ROMA-SERVICE<br />
		Gartenstraße 3<br />
		7511 Kleinbachselten<br />
		Austria
	</address>
	<p>
		ZVR: 876735702<br />
		<a href="mailto:office@roma-service.at">office@roma-service.at</a>
	</p>
	<p>
		{t('impressum.responsible')}: Dieter W. Halwachs<br />
		{t('impressum.technical')}: Valentin Edelsbrunner
	</p>
	<p>{t('impressum.funded')}</p>
</BaseLayout>

<style>
	.impressum-mark {
		font-size: 1.5rem;
		margin-bottom: var(--space-4);
	}
	address {
		font-style: normal;
	}
</style>
