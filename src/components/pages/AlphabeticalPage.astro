---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LetterNav from '../browse/LetterNav.astro';
import EntryListItem from '../browse/EntryListItem.astro';
import WordClassFilter from '../browse/WordClassFilter.astro';
import { entriesForLetter } from '../../lib/collection';
import { localizedWordClasses } from '../../lib/word-classes';
import { useTranslations, type Locale } from '../../i18n/ui';

interface Props {
	letter: string;
	lang: Locale;
}

const { letter, lang } = Astro.props;
const t = useTranslations(lang);
const { letters, matching } = await entriesForLetter(letter);

// Word classes actually present among this letter's entries (not the site-wide set) — a
// "second layer" filter on top of the letter, per feedback. See WordClassFilter.astro.
const classMap = new Map<string, { en: string | null; de: string | null }>();
for (const d of matching) {
	const { code, en, de } = d.wordClass.class1;
	if (code && !classMap.has(code)) classMap.set(code, { en, de });
}
const wordClasses = localizedWordClasses([...classMap].map(([code, label]) => ({ code, ...label })), lang);
---

<BaseLayout title={`${t('browse.letterHeading')} — ${letter.toUpperCase()}`} lang={lang}>
	<h1>{t('browse.letterHeading')}</h1>
	<div class="letter-row">
		<LetterNav letters={letters} current={letter} lang={lang} />
		<WordClassFilter classes={wordClasses} lang={lang} />
	</div>
	<p><span data-entry-count>{matching.length}</span> {t('browse.entries')}</p>
	<ul data-letter={letter} data-entry-list>
		{matching.map((d) => <EntryListItem slug={d.slug} lemma={d.lemma} glosses={d.glosses} lang={lang} wordClass={d.wordClass.class1.code} />)}
	</ul>
</BaseLayout>

<style>
	.letter-row {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-2);
	}
</style>

<script>
	// Progressive enhancement: remember which entry was clicked and where the list was scrolled,
	// so that returning here (via the entry page's back link, or the browser back button when
	// native scroll restoration doesn't kick in) both restores the scroll position and puts a
	// subtle highlight on the entry last visited. Scoped to sessionStorage (per tab) and to this
	// one list, keyed by letter — no server state, degrades to a no-op if storage is unavailable.
	// Runs on every page load rather than once per document: with view transitions the same
	// module stays alive while the letter pages swap underneath it, so a one-shot setup would
	// only ever restore the first list visited.
	const STORAGE_KEY = 'browse:lastClicked';

	const wired = new WeakSet<HTMLUListElement>();

	function restoreAndTrack() {
	const list = document.querySelector<HTMLUListElement>('ul[data-letter]');

	if (list && !wired.has(list)) {
		wired.add(list);
		const letter = list.dataset.letter;

		try {
			const raw = sessionStorage.getItem(STORAGE_KEY);
			if (raw) {
				const state = JSON.parse(raw) as { letter: string; slug: string; scrollY: number };
				if (state.letter === letter) {
					window.scrollTo(0, state.scrollY);
					const item = list.querySelector(`li[data-slug="${CSS.escape(state.slug)}"]`);
					item?.classList.add('recently-visited');
				}
			}
		} catch {
			// Storage disabled/unavailable — just skip restoration.
		}

		list.addEventListener('click', (event) => {
			const li = (event.target as HTMLElement).closest<HTMLLIElement>('li[data-slug]');
			if (!li?.dataset.slug) return;
			try {
				sessionStorage.setItem(
					STORAGE_KEY,
					JSON.stringify({ letter, slug: li.dataset.slug, scrollY: window.scrollY })
				);
			} catch {
				// Storage disabled/unavailable — the click still navigates normally.
			}
		});
	}
	}

	restoreAndTrack();
	document.addEventListener('astro:page-load', restoreAndTrack);
</script>
