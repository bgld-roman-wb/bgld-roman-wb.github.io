---
import ParadigmTable from './ParadigmTable.astro';
import type { Locale } from '../../i18n/ui';
import { localizePath, useTranslations } from '../../i18n/ui';

interface ParadigmForm {
	label: (string | null)[];
	labelDisplay?: { code: string; de: string; en: string };
	int?: string | null;
	deu?: string | null;
	intM?: string | null;
	intF?: string | null;
	deuM?: string | null;
	deuF?: string | null;
	german?: string | null;
	english?: string | null;
}

interface Props {
	paradigm: {
		kind: 'none' | 'exist' | 'gendered' | 'noun' | 'verb' | 'error';
		forms: ParadigmForm[];
	};
	lang: Locale;
}

const { paradigm, lang } = Astro.props;
const t = useTranslations(lang);
---

{paradigm.kind !== 'none' && (
	<details data-pagefind-weight="0.4">
		<summary data-pagefind-ignore>{t('entry.paradigm')}</summary>
		<ParadigmTable kind={paradigm.kind} forms={paradigm.forms} lang={lang} />
	</details>
)}
<p class="grammar-link" data-pagefind-ignore>
	{t('grammar.note')} <a href={localizePath('/grammar', lang)}>{t('grammar.link')}</a>
</p>

<style>
	.grammar-link {
		color: var(--color-muted);
		font-size: 0.85em;
		margin-block: var(--space-2) 0;
	}
	/* Hide the grammar-PDF pointer once the paradigm table itself is open — it's a "there's more
	   detail elsewhere" hint for the collapsed state, redundant once the reader is already looking
	   at the inflection data. */
	details[open] + .grammar-link {
		display: none;
	}
</style>
