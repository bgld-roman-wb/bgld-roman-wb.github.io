---
import type { Locale } from '../../i18n/ui';
import { useTranslations } from '../../i18n/ui';

interface Term {
	de: string;
	en: string;
}

interface ParadigmForm {
	label: (string | null)[];
	labelDisplay?: { code: string; group: Term; row: Term };
	int?: string | null;
	deu?: string | null;
	intM?: string | null;
	intF?: string | null;
	deuM?: string | null;
	deuF?: string | null;
	german?: string | null;
	english?: string | null;
}

interface Props {
	kind: 'none' | 'exist' | 'gendered' | 'noun' | 'verb' | 'error';
	forms: ParadigmForm[];
	lang: Locale;
}

const { kind, forms, lang } = Astro.props;
const t = useTranslations(lang);

// Layout follows the professor's spec (2026-11-18_korrekturen.pdf): a group label (Singular /
// Plural, or a tense) shown once, spanning its rows, then the row label (case or "1SG"), then
// the forms.
const text = (term?: Term) => (term ? term[lang] : '');
const code = (f: ParadigmForm) => f.labelDisplay?.code ?? f.label.filter(Boolean).join(' ');
const groupOf = (f: ParadigmForm) => text(f.labelDisplay?.group);
const rowOf = (f: ParadigmForm) => text(f.labelDisplay?.row) || code(f);

// rowspan for the group cell: set on the first row of each run of equal groups, 0 elsewhere.
const groupSpan = forms.map((f, i) => {
	if (i > 0 && groupOf(forms[i - 1]) === groupOf(f)) return 0;
	let n = 1;
	while (i + n < forms.length && groupOf(forms[i + n]) === groupOf(f)) n++;
	return n;
});

// The two Roman orthographies (DEU primary, INT secondary) frequently coincide. If INT equals
// DEU across the WHOLE table there is one form column and no "DEU/INT" header at all;
// otherwise both columns, with a ditto mark where a given INT cell matches its DEU cell.
const sameNV = (f: ParadigmForm) => (f.int || '') === (f.deu || '');
const sameGen = (f: ParadigmForm) => (f.intM || '') === (f.deuM || '') && (f.intF || '') === (f.deuF || '');
const intRedundantNV = forms.every(sameNV);
const intRedundantGen = forms.every(sameGen);
const DITTO = '〃';
---

{kind === 'error' && <p class="data-unavailable">{t('entry.inflectionUnavailable')}</p>}

{kind === 'exist' && (
	<div class="table-scroll">
		<table class="paradigm">
			<thead>
				<tr><td colspan="3"></td><th scope="col">{t('table.meaning')}</th></tr>
			</thead>
			<tbody>
				{forms.map((f, i) => (
					<tr class:list={{ 'group-start': groupSpan[i] > 0 && i > 0 }}>
						{groupSpan[i] > 0 && <th scope="rowgroup" rowspan={groupSpan[i]} class="group">{groupOf(f)}</th>}
						<th scope="row" class="row-label" title={code(f)}>{rowOf(f)}</th>
						<td class="word">{f.int}</td>
						<td>{lang === 'de' ? f.german : f.english}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
)}

{kind === 'gendered' && (
	<div class="table-scroll">
		<table class="paradigm">
			<thead>
				{intRedundantGen ? (
					<tr><td colspan="2"></td><th scope="col">{t('table.masc')}</th><th scope="col">{t('table.fem')}</th></tr>
				) : (
					<tr><td colspan="2"></td><th scope="col">DEU {t('table.masc')}</th><th scope="col">DEU {t('table.fem')}</th><th scope="col">INT {t('table.masc')}</th><th scope="col">INT {t('table.fem')}</th></tr>
				)}
			</thead>
			<tbody>
				{forms.map((f, i) => (
					<tr class:list={{ 'group-start': groupSpan[i] > 0 && i > 0 }}>
						{groupSpan[i] > 0 && <th scope="rowgroup" rowspan={groupSpan[i]} class="group">{groupOf(f)}</th>}
						<th scope="row" class="row-label" title={code(f)}>{rowOf(f)}</th>
						<td class="word">{f.deuM}</td>
						<td class="word">{f.deuF}</td>
						{!intRedundantGen && (sameGen(f) ? (
							<>
								<td class="ditto" title={t('table.sameAsGerman')}>{DITTO}</td>
								<td class="ditto" title={t('table.sameAsGerman')}>{DITTO}</td>
							</>
						) : (
							<>
								<td class="word">{f.intM}</td>
								<td class="word">{f.intF}</td>
							</>
						))}
					</tr>
				))}
			</tbody>
		</table>
	</div>
)}

{(kind === 'noun' || kind === 'verb') && (
	<div class="table-scroll">
		<table class="paradigm">
			{!intRedundantNV && (
				<thead>
					<tr><td colspan="2"></td><th scope="col">DEU</th><th scope="col">INT</th></tr>
				</thead>
			)}
			<tbody>
				{forms.map((f, i) => (
					<tr class:list={{ 'group-start': groupSpan[i] > 0 && i > 0 }}>
						{groupSpan[i] > 0 && <th scope="rowgroup" rowspan={groupSpan[i]} class="group">{groupOf(f)}</th>}
						<th scope="row" class="row-label" title={code(f)}>{rowOf(f)}</th>
						<td class="word">{f.deu}</td>
						{!intRedundantNV && (sameNV(f) ? (
							<td class="ditto" title={t('table.sameAsGerman')}>{DITTO}</td>
						) : (
							<td class="word">{f.int}</td>
						))}
					</tr>
				))}
			</tbody>
		</table>
	</div>
)}

<style>
	/* Matches the rest of the site: every rule is the same 1px hairline in --color-border, between
	   all rows and around the table. Sized to its content rather than stretched to the page width. */
	.paradigm {
		width: auto;
		min-width: min(100%, 24rem);
		margin-block: var(--space-2) var(--space-3);
	}
	.paradigm th,
	.paradigm td {
		vertical-align: baseline;
		padding: 0.45rem 2rem 0.45rem 0;
		border: none;
		border-bottom: 1px solid var(--color-border);
	}
	.paradigm thead td,
	.paradigm thead th {
		border-bottom: none;
	}
	.paradigm th:last-child,
	.paradigm td:last-child {
		padding-right: 0;
	}
	/* Column headers (m./f., DEU/INT, meaning): small and muted, like the site's section labels. */
	thead th {
		font-size: 0.8125rem;
		font-weight: 400;
		color: var(--color-muted);
		padding-bottom: 0.35rem;
	}
	/* All metadata is muted, so the Roman forms are the only full-contrast, bold text. */
	tbody th {
		font-weight: 400;
		color: var(--color-muted);
	}
	th.group {
		white-space: nowrap;
	}
	tbody tr:first-child > * {
		border-top: 1px solid var(--color-border);
	}
	.word {
		font-weight: 600;
	}
	.ditto {
		color: var(--color-muted);
		user-select: none;
	}
</style>
