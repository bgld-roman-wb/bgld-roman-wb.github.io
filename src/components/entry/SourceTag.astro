---
import type { Locale } from '../../i18n/ui';
import { labelFor, localizePath, useTranslations } from '../../i18n/ui';

interface Pair {
	int: string | null;
	deu: string | null;
}

interface Props {
	source: {
		code: string | null;
		isDerivation: boolean;
		label: { en: string | null; de: string | null } | null;
		foreignForm: Pair | null;
		derivationBase: Pair | null;
		derivationSlug: string | null;
	};
	lang: Locale;
}

const { source, lang } = Astro.props;
const t = useTranslations(lang);

// "etym?" isn't a language — it's a stand-in sentence ("keine Etymologie" / "no etymology") for
// entries with no documented origin, so it keeps its full label rather than becoming a code.
// Every real language gets its abbrs-lang code (e.g. "INC", "GRC") instead of the spelled-out
// name — professor's call: the full names ("Indoarisch", "Südslawisch", …) read as prose when
// what's wanted here is a terse etymological-dictionary-style abbreviation. The terse code alone
// can read as jargon though ("sla." means nothing on its own), so it's a hint-trigger — same
// dotted-underline tap/hover pattern as GrammarLine's flexion endings — revealing the full
// language name on demand rather than spelling it out inline.
const etymNoSource = source.code === 'etym?' ? labelFor(source.label, lang) : null;
const sourceCode = source.code && source.code !== 'etym?' ? `${source.code.toLowerCase()}.` : null;
// abbrs-lang labels sometimes carry an internal scope/period note in parentheses (e.g. "Südslawisch
// (global)", "Byzantinisch Griechisch (bis 1453)") — professor-facing classification detail, not
// meant for this public hint. Strip it.
const rawSourceLabel = source.code && source.code !== 'etym?' ? labelFor(source.label, lang) : null;
const sourceLabelHint = rawSourceLabel ? rawSourceLabel.replace(/\s*\([^)]*\)\s*$/, '').trim() : null;
const foreignForm = source.foreignForm?.deu ?? source.foreignForm?.int;
const derivationBase = source.derivationBase?.deu ?? source.derivationBase?.int ?? t('entry.derivedFromBase');
---

{source.code && (
	<section class="origin" data-pagefind-weight="0.5">
		<span class="origin-label">{t('entry.origin')}</span>
		<p class="origin-text">
			{source.isDerivation ? (
				<>
					{t('entry.derivedFrom')}{' '}
					{source.derivationSlug ? (
						<a href={localizePath(`/entry/${source.derivationSlug}`, lang)}>{derivationBase}</a>
					) : (
						<span>{derivationBase}</span>
					)}
				</>
			) : etymNoSource ? (
				<>{etymNoSource}</>
			) : sourceCode ? (
				<>
					{t('entry.sourceFrom')}{' '}
					<span class="hint-trigger" tabindex="0" data-hint={sourceLabelHint ?? undefined} aria-label={sourceLabelHint ?? sourceCode}>{sourceCode}</span>
					{foreignForm && <> {foreignForm}</>}
				</>
			) : null}
		</p>
	</section>
)}

<style>
	.origin {
		margin-block-start: var(--space-3);
	}
	.origin-label {
		display: block;
		font-size: 0.7rem;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--color-muted);
		margin-block-end: 0.15rem;
	}
	.origin-text {
		margin: 0;
		font-size: 0.95rem;
		color: var(--color-muted);
	}
	.origin-text .hint-trigger {
		border-bottom: 1px dotted currentColor;
	}
</style>
